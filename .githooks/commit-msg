#!/bin/sh
# Reject commit messages that are not Conventional Commits.
#
# Git runs this as the commit-msg hook and passes the path to the message file.
# Install it in a clone with `just hooks`.
set -eu

message_file=${1:-}
if [ -z "$message_file" ] || [ ! -r "$message_file" ]; then
    echo "commit-msg: expected a readable commit message file" >&2
    exit 1
fi

subject=$(sed -n '1p' "$message_file")

# Git generates these subjects itself, and interactive-rebase markers are
# temporary commits that a later rebase rewrites.
case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if printf '%s\n' "$subject" |
    grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'; then
    exit 0
fi

cat >&2 <<'EOF'
error: the commit subject is not a Conventional Commit

  <type>(<scope>)!: <description>

  type         feat, fix, docs, style, refactor, perf, test, build, ci, chore, or revert
  scope        optional; lowercase letters, digits, underscore, and hyphen
  !            optional; marks a breaking change
  description  required after ": "

Examples:
  feat(cli): add a --json flag
  fix: reject an empty session id
  docs(debugging-cake): explain exit codes

Merge commits, git-revert subjects, and fixup!/squash! markers are allowed.
EOF
exit 1
